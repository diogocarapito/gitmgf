# gitmgf configuration — copy to .env and fill in. Never commit .env.
# TECH_SPEC §4. In prod the app refuses to start with an unsafe SECRET_KEY, a non-https BASE_URL,
# no SMTP host, or any legal placeholder without a value (run: docker compose ... run --rm app cli check-config).

APP_ENV=prod
# 64 random hex chars: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
BASE_URL=https://gitmgf.com
ADMIN_EMAILS=you@example.org

# --- Caddy (TLS certificates from Let's Encrypt) ---
DOMAIN=gitmgf.com
ACME_EMAIL=admin@gitmgf.com

# --- Transactional email (EU provider, e.g. Brevo or Scaleway TEM) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=gitmgf <noreply@gitmgf.com>

# --- OAuth (optional: buttons only appear when configured) ---
# GitHub: Settings > Developer settings > OAuth Apps; callback https://gitmgf.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: Cloud Console > Credentials > OAuth client (Web); redirect https://gitmgf.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional token for repo sync (5 000 req/h instead of 60). A fine-grained token with no scopes is enough.
GITHUB_API_TOKEN=

# --- Backups: Litestream to EU S3-compatible storage (enable with --profile backup) ---
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=https://fsn1.your-objectstorage.com
LITESTREAM_REGION=fsn1
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# --- Monitoring (optional): pinged every 5 minutes by the scheduler, e.g. healthchecks.io ---
HEALTHCHECK_PING_URL=

# --- Legal page placeholders (content/legal/NOTES.md). Can also be set later in /pt/admin/settings. ---
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_TAX_ID=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_PRIVACY_EMAIL=privacidade@gitmgf.com
LEGAL_CONTACT_EMAIL=contacto@gitmgf.com
LEGAL_SECURITY_EMAIL=seguranca@gitmgf.com
LEGAL_DPO_STATEMENT=Não foi designado um encarregado de proteção de dados, por não ser obrigatório para o tratamento realizado (art. 37.º do RGPD). Para qualquer questão sobre privacidade, use o contacto acima.
LEGAL_DPO_STATEMENT_EN=No data protection officer has been appointed, as one is not required for this processing (GDPR Art. 37). For any privacy question, use the contact above.
LEGAL_HOSTING_PROVIDER=Hetzner Online GmbH
LEGAL_HOSTING_LOCATION=Alemanha
LEGAL_EMAIL_PROVIDER=Brevo (Sendinblue SAS)
LEGAL_EMAIL_PROVIDER_LOCATION=França
LEGAL_BACKUP_PROVIDER=Hetzner Online GmbH
LEGAL_BACKUP_LOCATION=Alemanha
LEGAL_COURT_DISTRICT=Lisboa
# The next four may be left empty on purpose (empty string = intentionally blank).
LEGAL_SITE_CODE_LICENSE_STATEMENT=
LEGAL_SITE_CODE_LICENSE_STATEMENT_EN=
LEGAL_ADR_STATEMENT=
LEGAL_ADR_STATEMENT_EN=
